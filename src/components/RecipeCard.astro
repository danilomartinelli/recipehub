---
import { cn } from "../utils/cn";

interface Props {
  gradientFrom: string;
  gradientTo: string;
  emoji: string;
  title: string;
  prepTimeLabel: string;
}

const { gradientFrom, gradientTo, emoji, title, prepTimeLabel } = Astro.props;
---

<div
  class={cn(
    "relative flex flex-col justify-between p-6 rounded-lg shadow-lg aspect-square",
    "bg-gradient-to-br",
    gradientFrom,
    gradientTo,
  )}
>
  <div class="absolute inset-0 flex items-center justify-center text-6xl opacity-20">
    {emoji}
  </div>
  <h3 class="relative z-10 text-xl font-semibold text-white mb-2">
    {title}
  </h3>
  <p class="relative z-10 text-sm text-white opacity-90">
    {prepTimeLabel}
  </p>
</div>